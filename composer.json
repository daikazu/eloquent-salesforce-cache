{
    "name": "daikazu/eloquent-salesforce-cache",
    "description": "Redis-backed caching layer for daikazu/eloquent-salesforce-objects",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Daikazu\\EloquentSalesforceCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Daikazu\\EloquentSalesforceCache\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0|^13.0",
        "daikazu/eloquent-salesforce-objects": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "orchestra/testbench": "^10.0|^11.0",
        "rector/rector": "^2.3",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29"
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Daikazu\\EloquentSalesforceCache\\EloquentSalesforceCacheServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
